# CPAP Data Uploader Configuration

# WiFi Settings
WIFI_SSID = YourNetworkName
WIFI_PASSWORD = YourNetworkPassword
HOSTNAME = cpap

# SMB Upload Settings
ENDPOINT_TYPE = SMB
ENDPOINT = //192.168.1.100/cpap_backups
ENDPOINT_USER = username
ENDPOINT_PASSWORD = password

# Upload Behavior
# UPLOAD_MODE: "smart" (uploads when CPAP is idle) or "scheduled" (uploads only during window)
UPLOAD_MODE = smart
UPLOAD_START_HOUR = 8
UPLOAD_END_HOUR = 22

# Smart Mode Tuning
INACTIVITY_SECONDS = 125      # Wait for this much silence before uploading
EXCLUSIVE_ACCESS_MINUTES = 5  # Max time to hold SD card per session
COOLDOWN_MINUTES = 10         # Wait this long between sessions

# Timezone (Offset from GMT in hours)
# Examples: PST=-8, EST=-5, UTC=0, CET=+1, JST=+9
GMT_OFFSET_HOURS = 0

# Advanced Power Settings
CPU_SPEED_MHZ = 240
WIFI_TX_PWR = high
WIFI_PWR_SAVING = none

# Webhooks (optional — fires on sync completion)
# GENERIC_WEBHOOK_URL = https://hc-ping.com/your-uuid
# WEBHOOK_EXTENDED_METADATA = true             (adds files_processed + bytes_transferred to payload)
# WEBHOOK_APPEND_FAIL_PATH = false             (appends /fail to generic URL on sync failure)
# SLEEPLAB_DOMAIN = https://your-sleeplab-instance.com
# SLEEPLAB_USER_ID = your-user-id              (leave blank to trigger all users)
# SLEEPLAB_SECRET = your-import-secret         (required by SleepLab API)
